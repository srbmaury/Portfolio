# AI provider keys for the career assistant.
# OpenAI is tried first when configured, then Gemini is used as fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: GitHub personal access token for /api/github-stats (higher rate limits).
# Without it, unauthenticated GitHub API allows 60 requests/hour per server IP.
GITHUB_TOKEN=

# Upstash Redis (REST) is recommended for production career-bot/GitHub caches
# and fixed-window rate limiting on /api/analyze-career. Without it, caches are off
# and rate limiting is disabled, which is suitable for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional frontend API override. In production, the frontend defaults to same-origin.
VITE_API_BASE_URL=

# Set to true to replace the hero projects CTA with the resume viewer.
VITE_SHOW_RESUME=

# Public embed/preview URL for the resume. For Google Drive, use /preview rather than /view.
VITE_RESUME_URL=https://drive.google.com/file/d/1zjOH4TpQ0FK6DhikaDr4xgO56xWRgqmV/preview

# Optional comma-separated list of allowed browser origins for the backend.
CLIENT_ORIGIN=https://saurabh-maurya-portfolio.netlify.app
